# Copy to .env (never commit .env) and fill in the values.
# Generate random secrets with: openssl rand -hex 32

DB_USERNAME=postgres
DB_PASSWORD=change-me

# Key the dashboard asks for; sent as the X-API-Key header
DOCDRIFT_API_KEY=
# Must match the secret on your GitHub webhook
GITHUB_WEBHOOK_SECRET=

# GitHub token with Contents + Pull requests read & write on tracked repositories
GITHUB_PAT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
