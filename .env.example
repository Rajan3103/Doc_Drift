# Copy to .env (never commit .env) and fill in the values.
# Generate random secrets with: openssl rand -hex 32

DB_USERNAME=postgres
DB_PASSWORD=change-me

# Key the dashboard asks for; sent as the X-API-Key header
DOCDRIFT_API_KEY=
# Must match the secret on your GitHub webhook
GITHUB_WEBHOOK_SECRET=

# GitHub token with Contents + Pull requests read & write on tracked repositories
GITHUB_PAT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Which AI to use: gemini or claude, and an optional fallback (claude, gemini or none)
LLM_PROVIDER=gemini
LLM_FALLBACK=none
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Optional: dashboard address linked from PR comments and alerts
DASHBOARD_URL=http://localhost:5173

# Optional: SMTP login for email alerts (also uncomment the mail lines in docker-compose.yml)
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
